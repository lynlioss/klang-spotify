<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><package android:name="io.github.lynlioss.klang" /></queries>
    <application android:label="Spotify for Klang" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name=".SpotifySourceService" android:exported="true">
            <intent-filter>
                <action android:name="io.github.lynlioss.klang.MUSIC_SOURCE_V1" />
                <action android:name="io.github.lynlioss.klang.MUSIC_IMPORT_V1" />
            </intent-filter>
            <meta-data android:name="klang.plugin" android:resource="@raw/plugin" />
        </service>
        <activity android:name=".SourceSettingsActivity" android:exported="true" />
    </application>
</manifest>
